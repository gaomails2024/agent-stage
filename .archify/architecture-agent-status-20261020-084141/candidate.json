    {
      "dot": "cyan",
      "title": "呈现层",
      "items": [
        "Tauri 常驻窗优先，Electron 作体积备选",
        "角色舞台把统一状态映射为二次元动作",
        "声音/语音提示后期可选，默认不挡主路径"
      ]
    },
    {
      "dot": "rose",
      "title": "高优状态",
      "items": [
        "needs_auth / needs_input 走授权闸门",
        "高优状态驱动更醒目的角色动作",
        "便于副屏一眼发现要人工介入的 Agent"
      ]
    },
    {
      "dot": "emerald",
      "title": "开源适配",
      "items": [
        "适配器主机与插件槽分离，便于社区贡献",
        "日志/CLI 与本地 API 两类常见接入方式",
        "外部厂商 Agent 始终在应用边界之外"
      ]
