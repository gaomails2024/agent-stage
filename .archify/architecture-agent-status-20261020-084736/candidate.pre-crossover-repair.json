  "cards": [
    {
      "dot": "cyan",
      "title": "自由配置",
      "items": [
        "配置页可改二次元形象与六态动作映射",
        "Agent 名册由用户手动增删改，并选择适配器类型",
        "自动发现仅作后期可选助手，不是唯一登记路径"
      ]
    },
    {
      "dot": "amber",
      "title": "本地配置仓库",
      "items": [
        "JSON/TOML 等本地文件持久化每用户配置",
        "同时供给角色舞台（形象/动作）与适配器主机（启用实例）",
        "监控列表是用户配置，不是写死在代码里的厂商清单"
      ]
    },
    {
      "dot": "emerald",
      "title": "开源适配",
      "items": [
        "适配器主机与社区扩展槽分离，便于贡献新厂商",
        "needs_auth / needs_input 经授权闸门做高优视觉，并由状态仓库推到角色舞台",
        "外部厂商 Agent 始终在应用边界之外"
      ]
    }
