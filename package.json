{
  "name": "agent-stage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "smoke": "tsx scripts/smoke.ts",
    "typecheck": "tsc -b --pretty false",
    "pack:mac": "bash scripts/pack-for-mac.sh",
    "bridge:workbuddy": "node scripts/bridges/buddy-jobs-poll.mjs --vendor workbuddy",
    "bridge:codebuddy": "node scripts/bridges/buddy-jobs-poll.mjs --vendor codebuddy",
    "bridge:live": "node scripts/bridges/macos-live-status-poll.mjs",
    "bridge:live:once": "node scripts/bridges/macos-live-status-poll.mjs --once"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "tsx": "^4.23.15",
    "typescript": "~7.0.2",
    "vite": "^8.3.4"
  },
  "description": "Multi-agent status stage with anime characters and pluggable adapters",
  "license": "MIT",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
